package-as: Move_Event_Toast
enable-nolib-creation: no
manual-changelog: CHANGELOG.md

# EXCLUSIONARY MINDSET (house rule -- see ../AGENTS.md): only .lua + .toc +
# CHANGELOG.md + logo.tga may ship. The packager archives tracked files at
# the tag, so every other tracked file must be listed below. Before adding a
# new tracked file that isn't shippable, add it to this list (and question
# whether it belongs in the public repo at all).
ignore:
    - LICENSE
    - README.md
    - .gitignore
    - .gitattributes
    - .github
    - tests
    # backup: gitignored and untracked, never packaged either way
    - AGENTS.md
    - AGENTS_MEMORY.md